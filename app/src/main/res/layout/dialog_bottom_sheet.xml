<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnAdd"
        app:hintTextColor="@color/green"
        app:boxStrokeColor="@color/green"
        app:cursorColor="@color/green"
        android:hint="@string/number">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnAdd"
        style="@style/bottomSheetButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilBottomSheet"
        app:layout_constraintBottom_toTopOf="@id/btnRemove"
        android:text="@string/add"
        />

    <Button
        android:id="@+id/btnRemove"
        style="@style/bottomSheetButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAdd"
        app:layout_constraintBottom_toTopOf="@id/btnAddOne"
        android:text="@string/remove" />

    <Button
        android:id="@+id/btnAddOne"
        style="@style/bottomSheetButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRemove"
        app:layout_constraintBottom_toTopOf="@id/btnRemoveOne"
        android:text="@string/addOne" />

    <Button
        android:id="@+id/btnRemoveOne"
        style="@style/bottomSheetButtons"
        android:layout_marginBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAddOne"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/removeOne" />

</androidx.constraintlayout.widget.ConstraintLayout>